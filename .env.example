DEBUG=True
SECRET_KEY=your-secret-key-here

DB_ENGINE=django.db.backends.postgresql
DB_NAME=skillshikshyacrm_db
DB_USER=skillshikshyacrm_user
DB_PASSWORD=skillshikshy@crm_pass!234
DB_HOST=db
DB_PORT=5432

ALLOWED_HOSTS=localhost,127.0.0.1

# OrbitChat integration
ORBITCHAT_API_URL=https://base.orbitchat.ai
ORBITCHAT_EMAIL=your-orbitchat-email
ORBITCHAT_PASSWORD=your-orbitchat-password

# Public Skill Shikshya course catalog (used to resolve external course names)
PUBLIC_COURSE_API_URL=https://base.skillshikshya.com/api/course/

# Public lead intake: senders put this in an X-Intake-Token header.
LEAD_INTAKE_TOKEN=
# Behind the frontend nginx, 1, so rate limits see the real client address.
NUM_PROXIES=1
